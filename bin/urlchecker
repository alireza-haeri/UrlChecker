#!/usr/bin/env bash

# Load Helpers
coreDirName="$(dirname "$0")/../core"
source "${coreDirName}/logger.sh"
source "${coreDirName}/valid-url.sh"
source "${coreDirName}/valid-count.sh"

# Get url
declare url
if [ -n "${1}" ]
then 
  url="${1}"
else
  read -r -p "Please enter your url:" url
fi

# Check is valid url
check-valid-url "${url}"

# Get count of test
declare count
if [ -n "${2}" ]
then 
  count="${2}"
else
  read -r -p "Please enter count of test:" count
fi
check-valid-count "${count}"

# Test url
. "${coreDirName}/tester.sh" "$url" "$count"
